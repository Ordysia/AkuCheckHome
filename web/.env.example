# Publiczna konfiguracja aplikacji klienckiej
NEXT_PUBLIC_SUPABASE_URL=https://twoj-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=uzupelnij_publiczny_klucz

# Opcjonalne: wyłącznie do lokalnego zasilania Supabase danymi syntetycznymi
# Nigdy nie udostępniaj prawdziwego secret key w repozytorium ani przeglądarce.
SUPABASE_SECRET_KEY=uzupelnij_lokalnie
ALLOW_SYNTHETIC_SEED=false
# Musi być identyczny z originem NEXT_PUBLIC_SUPABASE_URL i wskazywać projekt testowy.
ALLOW_SYNTHETIC_SUPABASE_URL=https://twoj-projekt-testowy.supabase.co
# Wymagane dodatkowo tylko dla: --target=supabase --clean
CONFIRM_SYNTHETIC_CLEAN=
